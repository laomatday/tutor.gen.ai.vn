# Optional deployment overrides; leave blank to use src/data/config/content-source.json.
# These VITE_ values are exposed to browsers. Use a public/publishable key only.
# Never set a Supabase secret or service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to local to force JSON fallback for offline/dev testing.
VITE_CONTENT_SOURCE=database
